scenario=>if onStart then {
tg.sendMsg('Реле давления перезагружено  ' + getIP());
pressure.enable(auto);
pressure.setMIN(min);
pressure.setMAX(max);
timer_pwm.stop();
pwm = 0;
dryRunningTimer.setInitCountDown(dryRunning);  
dryRunningTimer.stop();
}

if auto < 2 then pressure.enable(auto);
if min then pressure.setMIN(min);
if max then pressure.setMAX(max);

# счетчик uptime
if timer == 0 then uptime=getUptime()

# если включилось реле запускаем таймер плавного пуска
if relay then {
timer_pwm.reset();  
pressure.releState(relay);
dryRunningTimer.setInitCountDown(dryRunning);  
dryRunningTimer.reset();
}
if relay == 0 then {
timer_pwm.stop();
pwm = 0;
pressure.releState(relay);
dryRunningTimer.stop();
}

if dryRunningTimer == 0 then {
auto = 0;
relay = 0;
tg.sendMsg('Реле давления 🆘 Сработала защита от сухого хода');
}

# Плавный пуск. Меняем напряжение на каждом тике таймера
if timer_pwm == 3 & relay then  pwm = 800;
if timer_pwm == 2 & relay then  pwm = 950;
if timer_pwm == 1 & relay then  pwm = 1000;
if timer_pwm == 0 & relay then  pwm = 1024;

# Включаем светодиод, когда работает реле
if relay < 2 then Led5 = relay;