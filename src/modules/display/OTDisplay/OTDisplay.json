scenario=>if onStart then {
timerBrightness = 0;
OTDisplay.brightness(brightness);
# надписи на кнопках реле
OTDisplay.relay1("кухня");
OTDisplay.relay2("спальня");
OTDisplay.relay3("душ");
}

if weatherTimer == 0 then {
temp_C.get();
rangetempC.get();
weatherCode.get();
}

if OTDisplay < 100 then {
   # Увеличиваем яркость при касании экрана
   OTDisplay.brightness(brightnessActive);
   # Запускаем таймер
   timerDisp.reset();  
   timer.reset();
timerBrightness.setInitCountDown(brightnessActive)
timerBrightness.reset();
}
   # Плавно гасим яркость 
if timerBrightness > brightness then OTDisplay.brightness(timerBrightness);

if brightness then  OTDisplay.brightness(brightness);

if timerDisp == 0 then {
# переключаем экран когда таймер истек
   OTDisplay.display(0); 
    # включаем режим ожидания
    #OTDisplay.brightness(brightness);
}
   
if timer == 0 & disp then {
# Утро яркость 20
   if getHours() > 7 & getHours() < 10  then  {brightness = 20;  brightnessActive = 100;}
# День яркость 30
   if getHours() > 10 & getHours() < 18 then {brightness = 30;  brightnessActive = 100;}
# Вечер яркость 
   if getHours() > 18 & getHours() < 23 then {brightness = 20;  brightnessActive = 100;}
# Ночь. яркость  
   if getHours() > 23 | getHours() < 7 then {brightness = 10;  brightnessActive = 30;}
}